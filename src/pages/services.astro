---
import BaseLayout from '../layouts/BaseLayout.astro';

const services = [
  {
    id: 'photography',
    name: 'Photography',
    body: 'Portraits, campaigns, editorial. Images that feel like the people in them — not posed, not performed. Just true. We create space for people to be themselves in front of a camera. The result is work your audience recognizes as real.',
    goodForItems: [
      'The people on your website don’t look anything like the people you actually serve',
      'Your images feel cold when your work is anything but',
      'You’ve never had photos that truly captured what it feels like to be part of what you do',
    ],
    color: 'honey',
    comingSoon: false,
    preview: {
      title: 'Confluence Portraits',
      meta: 'Photography',
      href: '/projects/confluence',
      image: '/images/projects/confluence/Elly (Web)-10.jpg',
    },
  },
  {
    id: 'video-film',
    name: 'Video & Film',
    body: 'Brand films, documentaries, commercials. The kind of storytelling that earns trust before it asks for anything. We think about pacing, character, and emotional arc — not just shots. Whether we’re in a boardroom or hiking into the backcountry, we go where the story is.',
    goodForItems: [
      'You know your story is powerful but can’t figure out how to show it',
      'You’ve had videos made that inform people but don’t move them',
      'The impact you create deserves to be felt, not just explained',
    ],
    color: 'teal',
    comingSoon: false,
    preview: {
      title: 'Documentary Production',
      meta: 'Video & Film',
      href: '/work',
      image: '/images/bts/bts-portrait.jpg',
    },
  },
  {
    id: 'brand-strategy',
    name: 'Brand Strategy',
    body: 'Who you are, who you’re for, and how to say it in a way that actually reaches them. When your story is clear, the photo, the film, the site — all of it becomes intention instead of guesswork.',
    goodForItems: [
      'You say something different depending on who’s asking',
      'You know your value but lose people before they get it',
      'You’ve outgrown the words you started with and need new ones',
    ],
    color: 'lavender',
    comingSoon: true,
    preview: {
      title: 'Coming soon',
      meta: 'Brand Strategy',
      href: '/work',
      image: null,
    },
  },
  {
    id: 'website-development',
    name: 'Website Development',
    body: 'A site that matches your brand — and works as hard as you do. Clean, considered, and built to last longer than a trend cycle.',
    goodForItems: [
      'Your site no longer reflects who you’ve become',
      'People land on your page and don’t know what to do next',
      'Your brand and your website feel like two different organizations',
    ],
    color: 'sage',
    comingSoon: false,
    preview: {
      title: 'Coming soon',
      meta: 'Website Development',
      href: '/work',
      image: null,
    },
  },
];
---

<BaseLayout
  title="Services"
  description="Photo, Video, Brand Strategy, and Website Development. Take one. Take all four. Most of our best projects start with a conversation, not a checklist."
>

  <!-- ========== HERO ========== -->
  <section class="svc-hero film-grain">
    <div class="container svc-hero__inner">
      <h1 class="reveal text-balance">What we make, together.</h1>
      <p class="lede reveal reveal--delay-1">
        We work across four things. They tend to talk to each other &mdash; but we&rsquo;ll meet you wherever you need to start.
      </p>
    </div>
  </section>

  <!-- ========== SERVICES ========== -->
  {services.map((s) => (
    <section id={s.id} class:list={['section', 'svc-block', `svc-block--${s.color}`]}>
      <div class="container svc-block__grid">
        <aside class="svc-block__aside reveal">
          {s.comingSoon && <span class="svc-block__coming-soon">Coming soon</span>}
          <h2 class="svc-block__name text-balance">{s.name}</h2>
          <span class:list={['svc-block__bar', `svc-block__bar--${s.color}`]} aria-hidden="true"></span>
        </aside>

        <div class="svc-block__cards">
          <article class="svc-card reveal reveal--delay-1">
            <h3 class="svc-card__label">Overview</h3>
            <p class="svc-card__body">{s.body}</p>
          </article>

          <article class:list={['svc-card', 'svc-card--good', `svc-card--${s.color}`]}>
            <h3 class="svc-card__label">This is for you if&hellip;</h3>
            <ul class="svc-card__list">
              {s.goodForItems.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>

          <a href={s.preview.href} class="svc-preview reveal reveal--delay-2" aria-label={`See recent ${s.name.toLowerCase()} work`}>
            <div class:list={['svc-preview__thumb', `svc-preview__thumb--${s.color}`]} aria-hidden="true">
              {s.preview.image
                ? <img src={encodeURI(s.preview.image)} alt={s.preview.title} class="svc-preview__thumb-img" />
                : <span class="svc-preview__thumb-label">Recent work</span>
              }
            </div>
            <div class="svc-preview__meta">
              <span class="svc-preview__kind">{s.preview.meta}</span>
              <span class="svc-preview__title">{s.preview.title}</span>
              <span class="svc-preview__link">See project <span class="arrow">&rarr;</span></span>
            </div>
          </a>
        </div>
      </div>
    </section>
  ))}

  <!-- ========== CLOSING CTA ========== -->
  <section class="section section--cream">
    <div class="container--narrow">
      <div class="reveal" style="text-align: center;">
        <p class="closing-line">Hire us for one. Hire us for all four.</p>
        <a href="/contact" class="btn btn--solid" style="margin-top: 1.5rem;">Work with us &rarr;</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .svc-hero {
    padding: clamp(7rem, 14vw, 10rem) 0 clamp(3rem, 6vw, 5rem);
    background:
      radial-gradient(ellipse at 50% 0%, rgba(234, 170, 66, 0.2) 0%, transparent 55%),
      var(--paper);
  }

  .svc-hero__inner {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 820px;
  }

  .svc-hero h1 { font-size: clamp(2.5rem, 6vw, 4.25rem); }

  .svc-block {
    padding: clamp(3.5rem, 7vw, 6rem) 0;
    border-top: 1px solid var(--rule);
  }

  .svc-block:first-of-type { border-top: 0; }

  .svc-block__grid {
    display: grid;
    grid-template-columns: minmax(220px, 1fr) minmax(0, 2fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .svc-block__aside {
    position: sticky;
    top: 6rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .svc-block__coming-soon {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--lavender);
    background: rgba(106, 98, 120, 0.12);
    border: 1px solid rgba(106, 98, 120, 0.25);
    border-radius: 999px;
    padding: 0.25rem 0.75rem;
  }

  .svc-block__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--lavender-deep);
    margin: 0;
  }

  .svc-block__bar {
    display: inline-block;
    width: 64px;
    height: 4px;
    border-radius: 4px;
  }

  .svc-block__bar--honey    { background: var(--honey); }
  .svc-block__bar--teal     { background: var(--teal); }
  .svc-block__bar--lavender { background: var(--lavender); }
  .svc-block__bar--sage     { background: var(--sage); }

  .svc-block__cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .svc-card {
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    transition: transform var(--t-base) var(--ease), box-shadow var(--t-base) var(--ease);
  }

  .svc-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-soft);
  }

  .svc-card:first-child,
  .svc-card--good {
    grid-column: span 2;
  }

  .svc-card__label {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--honey-deep);
    margin-bottom: 0.9rem;
  }

  .svc-card__body {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--ink-soft);
    margin: 0;
  }

  .svc-card__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .svc-card__list li {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--ink-soft);
    padding-left: 1.25rem;
    position: relative;
  }

  .svc-card__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--honey);
    flex-shrink: 0;
  }

  .svc-card--good { background: var(--paper-cream); }
  .svc-card--good.svc-card--teal { background: rgba(85, 156, 173, 0.10); }
  .svc-card--good.svc-card--lavender { background: rgba(106, 98, 120, 0.10); }
  .svc-card--good.svc-card--sage { background: var(--sage-soft); }

  /* Preview card */
  .svc-preview {
    grid-column: span 2;
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 1.25rem;
    padding: 1rem;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    color: var(--ink);
    transition: transform var(--t-base) var(--ease), box-shadow var(--t-base) var(--ease), border-color var(--t-base) var(--ease);
  }

  .svc-preview:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-soft);
    border-color: var(--rule-strong);
    color: var(--ink);
  }

  .svc-preview__thumb {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--paper-warm);
  }

  .svc-preview__thumb--honey {
    background: linear-gradient(135deg, var(--honey-soft), var(--honey));
  }
  .svc-preview__thumb--teal {
    background: linear-gradient(135deg, #8FC0CB, var(--teal));
  }
  .svc-preview__thumb--lavender {
    background: linear-gradient(135deg, #8A8299, var(--lavender-deep));
  }
  .svc-preview__thumb--sage {
    background: linear-gradient(135deg, var(--sage-soft), var(--sage));
  }

  .svc-preview__thumb-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .svc-preview__thumb-label {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(26, 26, 26, 0.55);
  }

  .svc-preview__thumb--lavender .svc-preview__thumb-label {
    color: rgba(250, 249, 246, 0.7);
  }

  .svc-preview__meta {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.35rem;
    padding: 0.25rem 0.5rem 0.25rem 0;
  }

  .svc-preview__kind {
    font-size: 0.6875rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-mute);
    font-weight: 600;
  }

  .svc-preview__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.125rem;
    color: var(--lavender-deep);
    letter-spacing: -0.01em;
  }

  .svc-preview__link {
    margin-top: 0.35rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--teal-deep);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .svc-preview__link .arrow {
    display: inline-block;
    transition: transform var(--t-base) var(--ease);
  }

  .svc-preview:hover .svc-preview__link .arrow { transform: translateX(4px); }

  /* Closing */
  .closing-line {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2.5vw, 1.875rem);
    font-weight: 600;
    color: var(--lavender-deep);
    letter-spacing: -0.02em;
    margin: 0;
  }

  @media (max-width: 900px) {
    .svc-block__grid { grid-template-columns: 1fr; }
    .svc-block__aside { position: static; }
    .svc-block__cards { grid-template-columns: 1fr; }
    .svc-card:first-child { grid-column: span 1; }
    .svc-preview { grid-column: span 1; grid-template-columns: 120px 1fr; }
  }

  @media (max-width: 520px) {
    .svc-preview { grid-template-columns: 1fr; }
    .svc-preview__thumb { aspect-ratio: 16 / 9; }
  }

  .section__head { margin-bottom: 2rem; max-width: 720px; }
  .section__head .eyebrow { margin-bottom: 1rem; }
  .section__head h2 { margin-bottom: 1.25rem; }
</style>
