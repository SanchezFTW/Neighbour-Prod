---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';

// Bento cards — Photo is the "hero" tile, others fill the grid.
const bento = [
  {
    key: 'photo',
    title: 'Photo',
    blurb: 'Portraits, campaigns, editorial, the kind of images that feel like the people in them.',
    href: '/services#photography',
    color: 'honey',
    size: 'md',
    image: '/images/projects/confluence/Elly (Web)-10.jpg',
  },
  {
    key: 'video',
    title: 'Video',
    blurb: 'Commercials, brand films, documentary-style storytelling with a cinematic backbone.',
    href: '/services#video-film',
    color: 'teal',
    size: 'md',
    image: '/images/projects/yarrow/Yarrow BTS Service 1-18.jpg',
  },
  {
    key: 'brand',
    title: 'Brand Strategy',
    blurb: 'Figuring out who you are, who you\u2019re for, and what you\u2019re really saying.',
    href: '/services#brand-strategy',
    color: 'lavender',
    size: 'md',
    image: '/images/projects/confluence/Sam (Web)-3.jpg',
  },
  {
    key: 'web',
    title: 'Website Development',
    blurb: 'Sites that match the brand you just built, not fight it.',
    href: '/services#website-development',
    color: 'sage',
    size: 'md',
    image: '/images/projects/confluence/Kim (Web)-5.jpg',
  },
];

import { getCollection } from 'astro:content';
const allProjects = await getCollection('projects');
const featuredOrder = ['confluence'];
const featured = featuredOrder
  .map(slug => allProjects.find(p => p.id === slug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p) && Boolean(p!.data.featuredImage))
  .map(p => ({
    title: p.data.title,
    category: p.data.category,
    href: `/projects/${p.id}`,
    image: p.data.featuredImage ? encodeURI(p.data.featuredImage).replace(/#/g, '%23') : undefined,
    ratio: '4/5',
  }));
---

<BaseLayout title="Home">

  <!-- ========== HERO ========== -->
  <section class="hero film-grain">
    <div class="container hero__inner">
      <div class="hero__logo reveal" aria-hidden="true">
        <img
          src="/images/logos/Neighbour Logo Color.png"
          alt=""
        />
      </div>

      <h1 class="hero__headline reveal reveal--delay-1 text-balance">
        A creative studio helping the helpers.
      </h1>
    </div>

    <a href="#manifesto" class="hero__scroll reveal reveal--delay-2" aria-label="Scroll to content">
      <span class="hero__scroll-label">Scroll</span>
      <span class="hero__scroll-mouse" aria-hidden="true">
        <span class="hero__scroll-wheel"></span>
      </span>
    </a>
  </section>

  <!-- ========== MANIFESTO ========== -->
  <section id="manifesto" class="section section--cream manifesto">
    <div class="container">
      <div class="manifesto__inner">
        <div class="section__head reveal">
          <span class="eyebrow">Manifesto</span>
          <h2 class="text-balance">The helpers are usually the last ones to ask for help.</h2>
          <span class="bar"></span>
        </div>
        <div class="prose prose--justify reveal reveal--delay-1">
          <p>You&rsquo;re running the programs. Writing the grants. Managing the team. And somewhere in the middle of all of it, you need to tell your story &mdash; to funders, to your community, to the people who need what you offer.</p>
          <p>That&rsquo;s the part we handle.</p>
          <p>We&rsquo;re a husband-and-wife creative studio. Photo, film, brand strategy, websites. We make sure your work looks as good on the outside as it is on the inside &mdash; so you can get back to the thing you&rsquo;re actually here to do.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== SERVICES / BENTO ========== -->
  <section class="section services-bento-section">
    <div class="container">
      <div class="section__head reveal">
        <span class="eyebrow">Services</span>
        <h2 class="text-balance">What we make, together.</h2>
        <span class="bar"></span>
        <p class="section__lede">We work across four things, and they tend to talk to each other.</p>
      </div>

      <div class="bento">
        {bento.map((b, i) => (
          <a
            href={b.href}
            class:list={[
              'bento__card',
              `bento__card--${b.color}`,
              `bento__card--${b.size}`,
              'reveal',
              `reveal--delay-${(i % 4) + 1}`,
            ]}
            style={b.image ? `background-image: url('${encodeURI(b.image)}')` : ''}
          >
            <div class="bento__body">
              <h3 class="bento__title">{b.title}</h3>
              <p class="bento__blurb">{b.blurb}</p>
            </div>
            <span class="bento__cta" aria-hidden="true">
              Explore <span class="arrow">&rarr;</span>
            </span>
          </a>
        ))}
      </div>

      <p class="services-foot reveal reveal--delay-2">Hire us for one. Hire us for all four. We&rsquo;ll meet you where you are.</p>

      <div class="reveal reveal--delay-3" style="margin-top: 1.5rem;">
        <a href="/services" class="link">See the services <span class="arrow">&rarr;</span></a>
      </div>
    </div>
  </section>

  <!-- ========== WORK TEASER ========== -->
  <section class="section section--lg section--warm work">
    <div class="container">
      <div class="section__head section__head--row reveal">
        <div>
          <span class="eyebrow">Work</span>
          <h2>Recent work.</h2>
          <span class="bar"></span>
        </div>
        <a href="/work" class="link work__see-all">
          See all work <span class="arrow">&rarr;</span>
        </a>
      </div>

      <div class="work__grid">
        {featured.map((p, i) => (
          <div class:list={['reveal', `reveal--delay-${i + 1}`]}>
            <ProjectCard
              href={p.href}
              title={p.title}
              category={p.category}
              image={p.image}
              ratio={p.ratio}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========== WHY US ========== -->
  <section class="section section--sage film-grain why-us">
    <div class="container why-us__inner">
      <div class="why-us__copy reveal">
        <span class="eyebrow">Why us</span>
        <h2 class="text-balance">We&rsquo;re not going to oversell this.</h2>
        <span class="bar"></span>
        <div class="prose">
          <p>You need someone who shows up, does the work, and doesn&rsquo;t make the process harder than it needs to be. Someone who asks good questions, listens to the answers, and keeps their word.</p>
          <p>We listen before we pitch. We ask before we quote. We tell you if we&rsquo;re not the right fit, and we mean it when we say we are.</p>
          <p>That&rsquo;s the whole thing. Help, don&rsquo;t harm. We picked the name Neighbour for a reason &mdash; and we try to earn it every time.</p>
        </div>
      </div>

    </div>
  </section>

  <!-- ========== FINAL CTA ========== -->
  <section class="section--lavender cta-band film-grain">
    <div class="container cta-band__inner reveal">
      <h2 class="text-balance">Ready to be neighbours?</h2>
      <p>Tell us about it. We read every inquiry ourselves, and if we&rsquo;re a fit, we&rsquo;ll set up a call within a week.</p>
      <div class="btn-group">
        <a href="/contact" class="btn btn--solid">Fill out an inquiry form</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ---- Hero ---- */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    min-height: 100svh;
    padding: 2rem 0;
    overflow: hidden;
    background:
      radial-gradient(ellipse at 50% 0%, rgba(234, 170, 66, 0.24) 0%, transparent 55%),
      radial-gradient(circle at 15% 100%, rgba(85, 156, 173, 0.10) 0%, transparent 45%),
      var(--paper);
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
    max-width: 1100px;
  }

  .hero__logo {
    margin: 0;
    line-height: 0;
  }

  .hero__logo img {
    width: clamp(300px, 60vw, 760px);
    height: auto;
    display: block;
  }

  /* ---- Hero scroll indicator ---- */
  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: clamp(1.5rem, 4vh, 2.5rem);
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    color: var(--ink-soft, var(--ink));
    text-decoration: none;
    opacity: 0.75;
    transition: opacity var(--t-base) var(--ease);
  }

  .hero__scroll:hover { opacity: 1; }

  .hero__scroll-label {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .hero__scroll-mouse {
    width: 22px;
    height: 36px;
    border: 1.5px solid currentColor;
    border-radius: 12px;
    display: flex;
    justify-content: center;
    padding-top: 6px;
  }

  .hero__scroll-wheel {
    width: 2px;
    height: 6px;
    background: currentColor;
    border-radius: 2px;
    animation: hero-scroll-wheel 1.8s ease-in-out infinite;
  }

  @keyframes hero-scroll-wheel {
    0%   { transform: translateY(0);    opacity: 1; }
    60%  { transform: translateY(10px); opacity: 0; }
    61%  { transform: translateY(0);    opacity: 0; }
    100% { transform: translateY(0);    opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scroll-wheel { animation: none; }
  }

  .hero__headline {
    font-family: var(--font-display);
    font-weight: 500;
    color: var(--lavender-deep);
    font-size: clamp(1rem, 1.6vw, 1.375rem);
    line-height: 1.4;
    letter-spacing: -0.01em;
    max-width: 32ch;
    margin: 0;
  }

  .hero__lede {
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 54ch;
    margin: 0;
  }

  .hero .btn-group { justify-content: center; margin-top: 0.75rem; }

  @media (max-width: 768px) {
    .hero__logo img { width: min(78vw, 480px); }
    .hero { padding: 5rem 0 4rem; }
    .hero__scroll { bottom: 1.25rem; }
    .hero__scroll-label { font-size: 0.625rem; }
  }

  /* ---- Manifesto ---- */
  .manifesto__inner {
    max-width: 880px;
    margin: 0;
    text-align: left;
  }

  .manifesto .section__head { max-width: none; }

  .prose--justify p {
    text-align: justify;
    hyphens: auto;
  }

  /* ---- Section heads ---- */
  .section__head {
    margin-bottom: 3rem;
    max-width: 720px;
  }

  .section__head .eyebrow { margin-bottom: 1rem; }
  .section__head h2 { margin-bottom: 1.25rem; }
  .section__lede {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--ink-soft);
    max-width: 58ch;
    margin-top: 1.25rem;
  }

  .section__head--row {
    max-width: none;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  /* ---- Services bento ---- */
  .services-bento-section { border-top: 1px solid var(--rule); }

  .bento {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-auto-rows: minmax(220px, auto);
    gap: 1rem;
  }

  .bento__card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.75rem;
    border-radius: var(--radius-lg);
    color: var(--paper);
    overflow: hidden;
    isolation: isolate;
    transition: transform var(--t-base) var(--ease), box-shadow var(--t-base) var(--ease);
    border: 1px solid var(--rule);
    min-height: 220px;
    background-size: cover;
    background-position: center;
  }

  .bento__card::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    transition: opacity var(--t-base) var(--ease);
  }

  .bento__card > * { position: relative; z-index: 1; }

  .bento__card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lift);
  }

  .bento__card--lg {
    grid-column: span 3;
    grid-row: span 2;
    min-height: 460px;
  }

  .bento__card--md { grid-column: span 3; }

  .bento__card--wide { grid-column: 1 / -1; }

  .bento__card--honey::before {
    background: linear-gradient(to top, rgba(192, 140, 57, 0.88) 0%, rgba(234, 170, 66, 0.55) 50%, rgba(0,0,0,0.2) 100%);
  }

  .bento__card--teal::before {
    background: linear-gradient(to top, rgba(42, 100, 115, 0.92) 0%, rgba(85, 156, 173, 0.6) 50%, rgba(0,0,0,0.25) 100%);
  }

  .bento__card--lavender::before {
    background: linear-gradient(to top, rgba(59, 53, 72, 0.95) 0%, rgba(106, 98, 120, 0.65) 50%, rgba(0,0,0,0.3) 100%);
  }

  .bento__card--sage::before {
    background: linear-gradient(to top, rgba(60, 100, 70, 0.88) 0%, rgba(85, 136, 100, 0.55) 50%, rgba(0,0,0,0.2) 100%);
  }

  .bento__body { margin-top: auto; }

  .bento__title {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--paper);
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .bento__card--lg .bento__title { font-size: clamp(1.75rem, 3vw, 2.25rem); }

  .bento__blurb {
    color: rgba(250, 249, 246, 0.88);
    font-size: 0.9375rem;
    line-height: 1.6;
    max-width: 36ch;
  }

  .bento__card--lg .bento__blurb { font-size: 1rem; max-width: 42ch; }

  .bento__cta {
    margin-top: 1.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(250, 249, 246, 0.9);
  }

  .bento__cta .arrow { transition: transform var(--t-base) var(--ease); display: inline-block; }
  .bento__card:hover .bento__cta .arrow { transform: translateX(4px); }

  .services-foot {
    margin-top: 2.5rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--ink-soft);
    max-width: 60ch;
  }

  @media (max-width: 960px) {
    .bento { grid-template-columns: repeat(2, 1fr); grid-auto-rows: auto; }
    .bento__card--lg, .bento__card--md, .bento__card--wide {
      grid-column: span 1;
      grid-row: auto;
      min-height: 240px;
    }
  }

  @media (max-width: 560px) {
    .bento { grid-template-columns: 1fr; }
    .bento__card--lg, .bento__card--md, .bento__card--wide { grid-column: span 1; }
  }

  /* ---- Work grid ---- */
  .work__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    max-width: 960px;
    margin: 0 auto;
  }

  .work__grid :global(.project-card__title) { font-size: 0.9375rem; }
  .work__grid :global(.project-card__category) { font-size: 0.6875rem; }
  .work__grid :global(.project-card__caption) { margin-top: 0.75rem; }

  .work__see-all { white-space: nowrap; }

  @media (max-width: 820px) {
    .work__grid { grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  }

  @media (max-width: 520px) {
    .work__grid { grid-template-columns: 1fr; }
  }

  /* ---- Why us ---- */
  .why-us__inner {
    max-width: 720px;
  }

  .why-us__copy .bar { margin-bottom: 1.5rem; }

  /* ---- CTA band ---- */
  .cta-band {
    padding: clamp(5rem, 10vw, 8rem) 0;
    text-align: center;
    background:
      radial-gradient(circle at 80% 20%, rgba(234, 170, 66, 0.15), transparent 50%),
      var(--lavender-deep);
  }

  .cta-band__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    max-width: 640px;
  }

  .cta-band h2 {
    color: var(--paper);
    font-size: clamp(1.875rem, 3.6vw, 2.75rem);
    margin: 0.5rem 0 0.5rem;
  }

  .cta-band p {
    color: rgba(250, 249, 246, 0.82);
    font-size: 1.0625rem;
    margin-bottom: 1rem;
  }
</style>
