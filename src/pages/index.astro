---
import BaseLayout from '../layouts/BaseLayout.astro';

const bento = [
  {
    key: 'photo',
    title: 'Photo',
    blurb: 'Portraits, campaigns, editorial. Images that feel like the people in them.',
    href: '/services#photography',
    color: 'honey',
  },
  {
    key: 'video',
    title: 'Video',
    blurb: 'Brand films, documentaries, commercials. Storytelling that earns trust before it asks for anything.',
    href: '/services#video-film',
    color: 'teal',
  },
  {
    key: 'brand',
    title: 'Brand Strategy',
    blurb: "Who you are, who you're for, and how to say it in a way that actually reaches them.",
    href: '/services#brand-strategy',
    color: 'lavender',
  },
  {
    key: 'web',
    title: 'Website Development',
    blurb: 'A site that matches your mission — and works as hard as you do.',
    href: '/services#website-development',
    color: 'sage',
  },
];

---

<BaseLayout title="Home">

  <!-- ========== HERO ========== -->
  <section class="hero film-grain">
    <div class="container hero__inner">
      <div class="hero__logo reveal" aria-hidden="true">
        <img
          src="/images/logos/Neighbour Logo Color.png"
          alt=""
          fetchpriority="high"
          loading="eager"
          decoding="async"
        />
      </div>

      <h1 class="hero__headline reveal reveal--delay-1 text-balance">
        A creative studio helping the helpers.
      </h1>
    </div>

    <a href="#services" class="hero__scroll reveal reveal--delay-3" aria-label="Scroll to content">
      <span class="hero__scroll-label">Scroll</span>
      <span class="hero__scroll-mouse" aria-hidden="true">
        <span class="hero__scroll-wheel"></span>
      </span>
    </a>
  </section>

  <!-- ========== SERVICES / BENTO ========== -->
  <section id="services" class="section services-bento-section">
    <div class="container">
      <div class="section__head reveal">
        <span class="eyebrow">Services</span>
        <h2 class="text-balance">What we make, together.</h2>
        <span class="bar"></span>
        <p class="section__lede">We work across four things, and they tend to talk to each other.</p>
      </div>

      <div class="bento">
        {bento.map((b, i) => (
          <a
            href={b.href}
            class:list={[
              'bento__card',
              `bento__card--${b.color}`,
              `bento__card--${b.key}`,
              'reveal',
              `reveal--delay-${(i % 4) + 1}`,
            ]}
          >
            <div class="bento__body">
              <h3 class="bento__title">{b.title}</h3>
              <p class="bento__blurb">{b.blurb}</p>
            </div>
            <span class="bento__cta" aria-hidden="true">
              Explore <span class="arrow">&rarr;</span>
            </span>
          </a>
        ))}
      </div>

      <p class="services-foot reveal reveal--delay-2">Hire us for one. Hire us for all four. We&rsquo;ll meet you where you are.</p>
    </div>
  </section>

  <!-- ========== ABOUT ========== -->
  <section id="about" class="section section--cream about-section">
    <div class="container">
      <div class="about-layout">
        <div class="about-left reveal">
          <div class="about-left__inner">
            <span class="eyebrow">About</span>
            <h2 class="text-balance">Hi. We&rsquo;re Jared and Abigail.</h2>
            <span class="bar"></span>
            <div class="prose">
              <p>Jared is a filmmaker and creative strategist who spent years in commercials and film learning how to tell a story that lands. Abigail is a brand strategist, photographer, and director who thinks about who a story is <em>for</em> before she thinks about how it looks.</p>
              <p>Together we built a studio around the work that matters most to us &mdash; the helpers. The ones doing something real in the world.</p>
              <p>When you hire us, you get us. Our full attention, start to finish. No account manager, no handoff, no stranger on the edit.</p>
            </div>
          </div>
        </div>

        <div class="about-right">
          <div class="value-card reveal reveal--delay-1">
            <h3>We believe no one is born void.</h3>
            <p>Every person and every organization has something worth bringing to the surface. Our job is to help you find it.</p>
          </div>
          <div class="value-card reveal reveal--delay-2">
            <h3>We believe in moving forward with honesty.</h3>
            <p>Upfront about costs, timelines, and fit. If something isn&rsquo;t serving you, we&rsquo;ll say so.</p>
          </div>
          <div class="value-card reveal reveal--delay-3">
            <h3>We believe in the right thing for the right people.</h3>
            <p>Not the flashiest thing. The thing that actually works &mdash; for your audience, your work, and the moment you&rsquo;re in.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== CONTACT ========== -->
  <section id="contact" class="section contact-section">
    <div class="container">
      <div class="contact-section__head reveal">
        <span class="eyebrow">Contact</span>
        <h2 class="text-balance">Let&rsquo;s talk.</h2>
        <span class="bar"></span>
        <p class="lede">
          You don&rsquo;t need a polished brief or a clear budget before you reach out. Just tell us what you&rsquo;re working on and where you feel stuck.
        </p>
      </div>

      <div class="contact-layout">
        <form
          id="inquiry-form"
          class="inquiry-form reveal reveal--delay-1"
          action="https://formspree.io/f/xwvadbkl"
          method="POST"
          novalidate
        >
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" style="position:absolute;left:-10000px;width:1px;height:1px;opacity:0;" aria-hidden="true" />

          <div class="field-row">
            <div class="field">
              <label for="firstName">First name</label>
              <input id="firstName" name="firstName" type="text" required autocomplete="given-name" />
            </div>
            <div class="field">
              <label for="lastName">Last name</label>
              <input id="lastName" name="lastName" type="text" required autocomplete="family-name" />
            </div>
          </div>

          <div class="field">
            <label for="email">Your email</label>
            <input id="email" name="email" type="email" required autocomplete="email" />
          </div>

          <div class="field">
            <label for="org">Organization <span class="field__opt">(if any)</span></label>
            <input id="org" name="organization" type="text" autocomplete="organization" />
          </div>

          <div class="field">
            <label for="project">What are you working on?</label>
            <textarea id="project" name="project" rows="5" required placeholder="A short paragraph is plenty."></textarea>
          </div>

          <div class="field-row">
            <div class="field">
              <label for="projectType">Project type</label>
              <select id="projectType" name="projectType" required>
                <option value="" disabled selected>Pick one</option>
                <option value="Crafting a strategy">Crafting a strategy</option>
                <option value="Building a new brand">Building a new brand</option>
                <option value="Launching a campaign">Launching a campaign</option>
                <option value="Making a new website">Making a new website</option>
                <option value="Driving sales or traffic">Driving sales or traffic</option>
                <option value="Something not listed">Something not listed</option>
              </select>
            </div>
            <div class="field">
              <label for="timeline">Timeline</label>
              <select id="timeline" name="timeline" required>
                <option value="" disabled selected>Pick one</option>
                <option value="ASAP">ASAP</option>
                <option value="Next 1–3 months">Next 1&ndash;3 months</option>
                <option value="3–6 months">3&ndash;6 months</option>
                <option value="Just exploring">Just exploring</option>
              </select>
            </div>
          </div>

          <div class="field-row">
            <div class="field">
              <label for="budget">Budget range</label>
              <select id="budget" name="budget" required>
                <option value="" disabled selected>Pick one</option>
                <option value="Under $5k">Under $5k</option>
                <option value="$5k–$15k">$5k&ndash;$15k</option>
                <option value="$15k–$30k">$15k&ndash;$30k</option>
                <option value="$30k+">$30k+</option>
                <option value="Not sure yet">Not sure yet</option>
              </select>
            </div>
            <div class="field">
              <label for="referral">How&rsquo;d you find us?</label>
              <select id="referral" name="referral" required>
                <option value="" disabled selected>Pick one</option>
                <option value="Referral">Referral from a friend or colleague</option>
                <option value="Instagram">Instagram</option>
                <option value="Google search">Google search</option>
                <option value="Past project">Saw a past project of ours</option>
                <option value="Event">At an event</option>
                <option value="Other">Other</option>
              </select>
            </div>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn--solid">Send it over</button>
            <p id="form-status" class="form-status" role="status" aria-live="polite"></p>
          </div>
        </form>

        <aside class="contact-aside reveal reveal--delay-2">
          <h3>What happens next</h3>
          <ol class="next-list">
            <li><span class="next-num">1</span><p>We read your inquiry (actually &mdash; it&rsquo;s just the two of us).</p></li>
            <li><span class="next-num">2</span><p>If we think we&rsquo;re a fit, we&rsquo;ll reach out to book a call within about a week.</p></li>
            <li><span class="next-num">3</span><p>If we&rsquo;re not the right fit, we&rsquo;ll tell you that too &mdash; and point you toward someone who might be.</p></li>
          </ol>
          <p class="contact-aside__email">
            Or email us at <a href="mailto:info@neighbourprod.com">info@neighbourprod.com</a>.
          </p>
        </aside>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ---- Smooth anchor scroll ---- */
  :global(html) { scroll-behavior: smooth; scroll-padding-top: 5rem; }

  /* ---- Hero ---- */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    min-height: 100svh;
    padding: 2rem 0;
    overflow: hidden;
    background:
      radial-gradient(ellipse at 50% 0%, rgba(234, 170, 66, 0.24) 0%, transparent 55%),
      radial-gradient(circle at 15% 100%, rgba(85, 156, 173, 0.10) 0%, transparent 45%),
      var(--paper);
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
    max-width: 1100px;
  }

  .hero__logo { margin: 0; line-height: 0; }
  .hero__logo img {
    width: clamp(300px, 60vw, 760px);
    height: auto;
    display: block;
  }

  .hero__headline {
    font-family: var(--font-display);
    font-weight: 500;
    color: var(--lavender-deep);
    font-size: clamp(1rem, 1.6vw, 1.375rem);
    line-height: 1.4;
    letter-spacing: -0.01em;
    max-width: 32ch;
    margin: 0;
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: clamp(1.5rem, 4vh, 2.5rem);
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    color: var(--ink-soft, var(--ink));
    text-decoration: none;
    opacity: 0.75;
    transition: opacity var(--t-base) var(--ease);
  }
  .hero__scroll:hover { opacity: 1; }

  .hero__scroll-label {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .hero__scroll-mouse {
    width: 22px;
    height: 36px;
    border: 1.5px solid currentColor;
    border-radius: 12px;
    display: flex;
    justify-content: center;
    padding-top: 6px;
  }

  .hero__scroll-wheel {
    width: 2px;
    height: 6px;
    background: currentColor;
    border-radius: 2px;
    animation: hero-scroll-wheel 1.8s ease-in-out infinite;
  }

  @keyframes hero-scroll-wheel {
    0%   { transform: translateY(0);    opacity: 1; }
    60%  { transform: translateY(10px); opacity: 0; }
    61%  { transform: translateY(0);    opacity: 0; }
    100% { transform: translateY(0);    opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scroll-wheel { animation: none; }
    :global(html) { scroll-behavior: auto; }
  }

  @media (max-width: 768px) {
    .hero__logo img { width: min(78vw, 480px); }
    .hero { padding: 5rem 0 4rem; }
    .hero__scroll { bottom: 1.25rem; }
    .hero__scroll-label { font-size: 0.625rem; }
  }

  /* ---- Section heads ---- */
  .section__head {
    margin-bottom: 3rem;
    max-width: 720px;
  }
  .section__head .eyebrow { margin-bottom: 1rem; }
  .section__head h2 { margin-bottom: 1.25rem; }
  .section__lede {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--ink-soft);
    max-width: 58ch;
    margin-top: 1.25rem;
  }

  /* ---- Services bento ---- */
  .services-bento-section { border-top: 1px solid var(--rule); }

  .bento {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: 200px 200px 160px;
    grid-template-areas:
      "photo photo video"
      "photo photo brand"
      "web   web   web  ";
    gap: 1rem;
  }

  .bento__card--photo { grid-area: photo; }
  .bento__card--video { grid-area: video; }
  .bento__card--brand { grid-area: brand; }
  .bento__card--web   { grid-area: web; }

  .bento__card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.75rem;
    border-radius: var(--radius-lg);
    color: var(--paper);
    overflow: hidden;
    isolation: isolate;
    transition: transform var(--t-base) var(--ease), box-shadow var(--t-base) var(--ease);
    border: 1px solid var(--rule);
  }

  .bento__card::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    transition: opacity var(--t-base) var(--ease);
  }

  .bento__card > * { position: relative; z-index: 1; }
  .bento__card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lift); }

  .bento__card--honey::before {
    background: linear-gradient(135deg, #C08C39 0%, #EAAA42 60%, #F5D38A 100%);
  }
  .bento__card--teal::before {
    background: linear-gradient(135deg, #2A6473 0%, #559CAD 60%, #8FC0CB 100%);
  }
  .bento__card--lavender::before {
    background: linear-gradient(135deg, #3B3548 0%, #6A6278 60%, #8A8299 100%);
  }
  .bento__card--sage::before {
    background: linear-gradient(135deg, #3C6446 0%, #5E9467 60%, #BCD8C1 100%);
  }

  .bento__body { margin-top: auto; }

  .bento__title {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--paper);
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .bento__blurb {
    color: rgba(250, 249, 246, 0.88);
    font-size: 0.9375rem;
    line-height: 1.6;
    max-width: 36ch;
  }

  .bento__cta {
    margin-top: 1.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(250, 249, 246, 0.9);
  }
  .bento__cta .arrow { transition: transform var(--t-base) var(--ease); display: inline-block; }
  .bento__card:hover .bento__cta .arrow { transform: translateX(4px); }

  .services-foot {
    margin-top: 2.5rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--ink-soft);
    max-width: 60ch;
  }

  @media (max-width: 860px) {
    .bento {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 180px 180px 180px;
      grid-template-areas:
        "photo photo"
        "video brand"
        "web   web  ";
    }
  }

  @media (max-width: 540px) {
    .bento {
      grid-template-columns: 1fr;
      grid-template-rows: 200px 160px 160px 160px;
      grid-template-areas:
        "photo"
        "video"
        "brand"
        "web";
    }
  }

  /* ============================================== */
  /* ================== ABOUT ===================== */
  /* ============================================== */
  .about-section { border-top: 1px solid var(--rule); }

  .about-layout {
    display: grid;
    grid-template-columns: minmax(280px, 1fr) minmax(0, 1.5fr);
    gap: clamp(3rem, 6vw, 5rem);
    align-items: start;
  }

  .about-left__inner {
    position: sticky;
    top: 6rem;
  }

  .about-right {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .value-card {
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    padding: 1.75rem 2rem;
    transition: transform var(--t-base) var(--ease), box-shadow var(--t-base) var(--ease);
  }

  .value-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-soft);
  }

  .value-card h3 {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--lavender-deep);
    margin-bottom: 0.75rem;
    letter-spacing: -0.01em;
  }

  .value-card p {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--ink-soft);
    margin: 0;
  }

  @media (max-width: 860px) {
    .about-layout { grid-template-columns: 1fr; }
    .about-left__inner { position: static; }
  }

  /* ============================================== */
  /* ================= CONTACT ==================== */
  /* ============================================== */
  .contact-section {
    background:
      radial-gradient(ellipse at 50% 0%, rgba(234, 170, 66, 0.18) 0%, transparent 55%),
      var(--paper);
    border-top: 1px solid var(--rule);
  }

  .contact-section__head {
    max-width: 780px;
    margin: 0 auto 3rem;
    text-align: center;
  }

  .contact-section__head .bar { margin-left: auto; margin-right: auto; display: block; }

  .contact-layout {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: start;
    max-width: 1100px;
    margin: 0 auto;
  }

  @media (max-width: 860px) {
    .contact-layout { grid-template-columns: 1fr; }
  }

  .inquiry-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .field { display: flex; flex-direction: column; gap: 0.5rem; }

  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  @media (max-width: 520px) { .field-row { grid-template-columns: 1fr; } }

  .field label {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--lavender-deep);
  }

  .field__opt {
    font-weight: 400;
    letter-spacing: 0.02em;
    text-transform: none;
    color: var(--ink-mute);
    font-size: 0.75rem;
  }

  .field input[type="text"],
  .field input[type="email"],
  .field textarea,
  .field select {
    font-family: inherit;
    font-size: 1rem;
    color: var(--ink);
    background: var(--paper);
    padding: 0.85rem 1rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    transition: border-color var(--t-fast) ease, box-shadow var(--t-fast) ease;
    width: 100%;
  }

  .field textarea { resize: vertical; min-height: 140px; line-height: 1.6; }

  .field input:focus,
  .field textarea:focus,
  .field select:focus {
    outline: none;
    border-color: var(--honey);
    box-shadow: 0 0 0 3px rgba(234, 170, 66, 0.22);
  }

  .form-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  .form-status { font-size: 0.875rem; color: var(--ink-soft); margin: 0; }
  .form-status.is-error { color: #a23a3a; }
  .form-status.is-success { color: var(--teal-deep); }

  .contact-aside {
    background: var(--paper-cream);
    border-radius: var(--radius-lg);
    padding: clamp(1.75rem, 3vw, 2.5rem);
    position: sticky;
    top: 7rem;
  }

  .contact-aside h3 { font-size: 1.25rem; margin-bottom: 1.5rem; }

  .next-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .next-list li {
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 1rem;
    align-items: start;
  }

  .next-num {
    width: 32px;
    height: 32px;
    border-radius: 999px;
    background: var(--honey);
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.875rem;
  }

  .next-list p { font-size: 0.9375rem; line-height: 1.65; margin: 0; }

  .contact-aside__email {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }

  .contact-aside__email a { color: var(--teal-deep); font-weight: 600; }

  @media (max-width: 860px) {
    .contact-aside { position: static; }
  }

  @media (max-width: 520px) {
    .field input[type="text"],
    .field input[type="email"],
    .field textarea,
    .field select {
      font-size: 16px;
      padding: 0.85rem 0.9rem;
    }
    .form-actions { flex-direction: column; align-items: stretch; gap: 0.85rem; }
    .form-actions .btn { justify-content: center; }
  }
</style>

<script>
  function initInquiryForm() {
    const form = document.getElementById('inquiry-form') as HTMLFormElement | null;
    const status = document.getElementById('form-status');
    if (!form || !status) return;
    if (form.dataset.fsBound === '1') return;
    form.dataset.fsBound = '1';

    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      status.classList.remove('is-error', 'is-success');
      status.textContent = 'Sending…';
      if (submitBtn) submitBtn.disabled = true;

      const fd = new FormData(form);
      const firstName = String(fd.get('firstName') || '');
      const lastName = String(fd.get('lastName') || '');
      const fullName = `${firstName} ${lastName}`.trim();

      fd.set('_subject', `New inquiry from ${fullName}`);
      const emailVal = String(fd.get('email') || '');
      if (emailVal) fd.set('_replyto', emailVal);

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: fd,
          headers: { Accept: 'application/json' },
        });

        if (res.ok) {
          status.classList.add('is-success');
          status.textContent = 'Thanks — we got your note and will be in touch soon.';
          form.reset();
        } else {
          const data = await res.json().catch(() => null);
          const msg = data?.errors?.map((err: { message: string }) => err.message).join(', ');
          throw new Error(msg || 'Submission failed');
        }
      } catch (err) {
        status.classList.add('is-error');
        status.textContent = 'Something went wrong sending your inquiry. Please email info@neighbourprod.com directly.';
      } finally {
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  }

  initInquiryForm();
  document.addEventListener('astro:page-load', initInquiryForm);
</script>
