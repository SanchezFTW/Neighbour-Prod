---
import BaseLayout from '../layouts/BaseLayout.astro';

const bento = [
  {
    key: 'photo',
    title: 'Photo',
    blurb: 'Portraits, campaigns, editorial. Images that feel like the people in them.',
    href: '/services#photography',
    color: 'honey',
  },
  {
    key: 'video',
    title: 'Video',
    blurb: 'Brand films, documentaries, commercials. Storytelling that earns trust before it asks for anything.',
    href: '/services#video-film',
    color: 'teal',
  },
  {
    key: 'brand',
    title: 'Brand Strategy',
    blurb: "Who you are, who you're for, and how to say it in a way that actually reaches them.",
    href: '/services#brand-strategy',
    color: 'lavender',
  },
  {
    key: 'web',
    title: 'Website Development',
    blurb: 'A site that matches your mission — and works as hard as you do.',
    href: '/services#website-development',
    color: 'sage',
  },
];

---

<BaseLayout title="Home">

  <!-- ========== HERO ========== -->
  <section class="hero film-grain">
    <div class="container hero__inner">
      <div class="hero__logo reveal" aria-hidden="true">
        <img
          src="/images/logos/Neighbour Logo Color.png"
          alt=""
          fetchpriority="high"
          loading="eager"
          decoding="async"
        />
      </div>

      <h1 class="hero__headline reveal reveal--delay-1 text-balance">
        A creative studio helping the helpers.
      </h1>
    </div>

    <a href="#services" class="hero__scroll reveal reveal--delay-3" aria-label="Scroll to content">
      <span class="hero__scroll-label">Scroll</span>
      <span class="hero__scroll-mouse" aria-hidden="true">
        <span class="hero__scroll-wheel"></span>
      </span>
    </a>
  </section>

  <!-- ========== SERVICES / BENTO ========== -->
  <section id="services" class="section services-bento-section">
    <div class="container">
      <div class="section__head reveal">
        <span class="eyebrow">Services</span>
        <h2 class="text-balance">What we make, together.</h2>
        <span class="bar"></span>
        <p class="section__lede">We work across four things, and they tend to talk to each other.</p>
      </div>

      <div class="bento">
        {bento.map((b, i) => (
          <a
            href={b.href}
            class:list={[
              'bento__card',
              `bento__card--${b.color}`,
              `bento__card--${b.key}`,
              'reveal',
              `reveal--delay-${(i % 4) + 1}`,
            ]}
          >
            <div class="bento__body">
              <h3 class="bento__title">{b.title}</h3>
            </div>
            <p class="bento__blurb">{b.blurb}</p>
            <span class="bento__cta" aria-hidden="true">
              Explore <span class="arrow">&rarr;</span>
            </span>
          </a>
        ))}
      </div>

      <p class="services-foot reveal reveal--delay-2">Hire us for one. Hire us for all four. We&rsquo;ll meet you where you are.</p>
    </div>
  </section>

  <!-- ========== ABOUT ========== -->
  <section id="about" class="section section--cream about-section">
    <div class="container">
      <div class="about-layout">
        <div class="about-left reveal">
          <div class="about-left__inner">
            <span class="eyebrow">About</span>
            <h2 class="text-balance">Hi. We&rsquo;re Jared and Abigail.</h2>
            <span class="bar"></span>
            <div class="prose">
              <p>Jared is a filmmaker and creative strategist who spent years in commercials and film learning how to tell a story that lands. Abigail is a brand strategist, photographer, and director who thinks about who a story is <em>for</em> before she thinks about how it looks.</p>
              <p>Together we built a studio around the work that matters most to us &mdash; the helpers.</p>
            </div>
          </div>
        </div>

        <div class="about-right">
          <div class="value-card reveal reveal--delay-1">
            <h3>We believe no one is born void.</h3>
            <p>Every person and every organization has something worth bringing to the surface. Our job is to help you find it.</p>
          </div>
          <div class="value-card reveal reveal--delay-2">
            <h3>We believe in moving forward with honesty.</h3>
            <p>Upfront about costs, timelines, and fit. If something isn&rsquo;t serving you, we&rsquo;ll say so.</p>
          </div>
          <div class="value-card reveal reveal--delay-3">
            <h3>We believe in the right thing for the right people.</h3>
            <p>Not the flashiest thing. The thing that actually works &mdash; for your audience, your work, and the moment you&rsquo;re in.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== CONTACT CTA ========== -->
  <section id="contact" class="section section--warm contact-cta-section">
    <div class="container--narrow">
      <div class="contact-cta reveal">
        <span class="eyebrow">Work with us</span>
        <h2 class="text-balance">Let&rsquo;s work together.</h2>
        <span class="bar"></span>
        <p class="lede">
          You don&rsquo;t need a polished brief before reaching out. Just tell us what you&rsquo;re working on &mdash; we&rsquo;ll take it from there.
        </p>
        <a href="/contact" class="btn btn--solid reveal reveal--delay-1">Get in touch</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ---- Smooth anchor scroll ---- */
  :global(html) { scroll-behavior: smooth; scroll-padding-top: 5rem; }

  /* ---- Hero ---- */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    min-height: 100svh;
    padding: 2rem 0;
    overflow: hidden;
    background:
      radial-gradient(ellipse at 50% 0%, rgba(234, 170, 66, 0.24) 0%, transparent 55%),
      radial-gradient(circle at 15% 100%, rgba(85, 156, 173, 0.10) 0%, transparent 45%),
      var(--paper);
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
    max-width: 1100px;
  }

  .hero__logo { margin: 0; line-height: 0; }
  .hero__logo img {
    width: clamp(300px, 60vw, 760px);
    height: auto;
    display: block;
  }

  .hero__headline {
    font-family: var(--font-display);
    font-weight: 500;
    color: var(--lavender-deep);
    font-size: clamp(1.125rem, 2vw, 1.75rem);
    line-height: 1.4;
    letter-spacing: -0.01em;
    max-width: 32ch;
    margin: 0;
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: clamp(1.5rem, 4vh, 2.5rem);
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    color: var(--ink-soft, var(--ink));
    text-decoration: none;
    opacity: 0.75;
    transition: opacity var(--t-base) var(--ease);
  }
  .hero__scroll:hover { opacity: 1; }

  .hero__scroll-label {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .hero__scroll-mouse {
    width: 22px;
    height: 36px;
    border: 1.5px solid currentColor;
    border-radius: 12px;
    display: flex;
    justify-content: center;
    padding-top: 6px;
  }

  .hero__scroll-wheel {
    width: 2px;
    height: 6px;
    background: currentColor;
    border-radius: 2px;
    animation: hero-scroll-wheel 1.8s ease-in-out infinite;
  }

  @keyframes hero-scroll-wheel {
    0%   { transform: translateY(0);    opacity: 1; }
    60%  { transform: translateY(10px); opacity: 0; }
    61%  { transform: translateY(0);    opacity: 0; }
    100% { transform: translateY(0);    opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scroll-wheel { animation: none; }
    :global(html) { scroll-behavior: auto; }
  }

  @media (max-width: 768px) {
    .hero__logo img { width: min(78vw, 480px); }
    .hero { padding: 5rem 0 4rem; }
    .hero__scroll { bottom: 1.25rem; }
    .hero__scroll-label { font-size: 0.625rem; }
  }

  /* ---- Section heads ---- */
  .section__head {
    margin-bottom: 3rem;
    max-width: 720px;
  }
  .section__head .eyebrow { margin-bottom: 1rem; }
  .section__head h2 { margin-bottom: 1.25rem; }
  .section__lede {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--ink-soft);
    max-width: 58ch;
    margin-top: 1.25rem;
  }

  /* ---- Services bento ---- */
  .services-bento-section { border-top: 1px solid var(--rule); }

  .bento {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .bento__card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding: 1.75rem;
    border-radius: var(--radius-lg);
    color: var(--paper);
    overflow: hidden;
    isolation: isolate;
    min-height: 240px;
    transition: transform var(--t-base) var(--ease), box-shadow var(--t-base) var(--ease);
    border: 1px solid var(--rule);
  }

  .bento__card::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    transition: opacity var(--t-base) var(--ease);
  }

  .bento__card > * { position: relative; z-index: 1; }
  .bento__card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lift); }

  .bento__card--honey::before {
    background: linear-gradient(135deg, #C08C39 0%, #EAAA42 60%, #F5D38A 100%);
  }
  .bento__card--teal::before {
    background: linear-gradient(135deg, #2A6473 0%, #559CAD 60%, #8FC0CB 100%);
  }
  .bento__card--lavender::before {
    background: linear-gradient(135deg, #3B3548 0%, #6A6278 60%, #8A8299 100%);
  }
  .bento__card--sage::before {
    background: linear-gradient(135deg, #3C6446 0%, #5E9467 60%, #BCD8C1 100%);
  }

  .bento__blurb { margin-top: auto; }

  .bento__body { margin-top: 0; margin-bottom: 0; }

  .bento__title {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--paper);
    font-size: 1.5rem;
    margin-bottom: 0;
  }

  .bento__blurb {
    color: rgba(250, 249, 246, 0.88);
    font-size: 0.9375rem;
    line-height: 1.6;
    max-width: 36ch;
    margin-bottom: 0.75rem;
  }

  .bento__cta {
    margin-top: 1.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(250, 249, 246, 0.9);
  }
  .bento__cta .arrow { transition: transform var(--t-base) var(--ease); display: inline-block; }
  .bento__card:hover .bento__cta .arrow { transform: translateX(4px); }

  .services-foot {
    margin-top: 2.5rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--ink-soft);
    max-width: 60ch;
  }

  @media (max-width: 860px) {
    .bento {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 540px) {
    .bento {
      grid-template-columns: 1fr;
    }
  }

  /* ============================================== */
  /* ================== ABOUT ===================== */
  /* ============================================== */
  .about-section { border-top: 1px solid var(--rule); }

  .about-layout {
    display: grid;
    grid-template-columns: minmax(280px, 1fr) minmax(0, 1.5fr);
    gap: clamp(3rem, 6vw, 5rem);
    align-items: start;
  }

  .about-left__inner {
    position: sticky;
    top: 6rem;
  }

  .about-right {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .value-card {
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    padding: 1.75rem 2rem;
    transition: transform var(--t-base) var(--ease), box-shadow var(--t-base) var(--ease);
  }

  .value-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-soft);
  }

  .value-card h3 {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--lavender-deep);
    margin-bottom: 0.75rem;
    letter-spacing: -0.01em;
  }

  .value-card p {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--ink-soft);
    margin: 0;
  }

  @media (max-width: 860px) {
    .about-layout { grid-template-columns: 1fr; }
    .about-left__inner { position: static; }
  }

  /* ============================================== */
  /* ================= CONTACT CTA ================ */
  /* ============================================== */
  .contact-cta-section {
    border-top: 1px solid var(--rule);
  }

  .contact-cta {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .contact-cta .bar { margin-left: auto; margin-right: auto; display: block; }

  .contact-cta .lede { max-width: 560px; }

  .contact-cta .btn { margin-top: 0.5rem; }
</style>

