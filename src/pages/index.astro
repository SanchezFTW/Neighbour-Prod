---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';

// Bento cards — Photo is the "hero" tile, others fill the grid.
const bento = [
  {
    key: 'photo',
    title: 'Photo',
    blurb: 'Portraits, campaigns, editorial. Images that feel like the people in them.',
    href: '/services#photography',
    color: 'honey',
    size: 'md',
    image: '/images/projects/confluence/Elly (Web)-10.jpg',
  },
  {
    key: 'video',
    title: 'Video',
    blurb: 'Brand films, documentaries, commercials. Storytelling that earns trust before it asks for anything.',
    href: '/services#video-film',
    color: 'teal',
    size: 'md',
    image: '/images/bts/bts-mountains-snow.jpg',
  },
  {
    key: 'brand',
    title: 'Brand Strategy',
    blurb: 'Who you are, who you\u2019re for, and how to say it in a way that actually reaches them.',
    href: '/services#brand-strategy',
    color: 'lavender',
    size: 'md',
    image: '/images/projects/confluence/Sam (Web)-3.jpg',
  },
  {
    key: 'web',
    title: 'Website Development',
    blurb: 'A site that matches your mission \u2014 and works as hard as you do.',
    href: '/services#website-development',
    color: 'sage',
    size: 'md',
    image: '/images/projects/confluence/Kim (Web)-5.jpg',
  },
];

import { getCollection } from 'astro:content';
const allProjects = await getCollection('projects');
const featuredOrder = ['confluence-website', 'confluence'];
const featured = featuredOrder
  .map(slug => allProjects.find(p => p.id === slug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p) && Boolean(p!.data.featuredImage))
  .map(p => ({
    title: p.data.title,
    category: p.data.category,
    href: `/projects/${p.id}`,
    image: p.data.featuredImage ? encodeURI(p.data.featuredImage).replace(/#/g, '%23') : undefined,
    ratio: '4/5',
  }));
---

<BaseLayout title="Home">

  <!-- ========== HERO ========== -->
  <section class="hero film-grain">
    <div class="container hero__inner">
      <div class="hero__logo reveal" aria-hidden="true">
        <img
          src="/images/logos/Neighbour Logo Color.png"
          alt=""
        />
      </div>

      <h1 class="hero__headline reveal reveal--delay-1 text-balance">
        A creative studio helping the helpers.
      </h1>
    </div>

    <a href="#manifesto" class="hero__scroll reveal reveal--delay-3" aria-label="Scroll to content">
      <span class="hero__scroll-label">Scroll</span>
      <span class="hero__scroll-mouse" aria-hidden="true">
        <span class="hero__scroll-wheel"></span>
      </span>
    </a>
  </section>

  <!-- ========== MANIFESTO ========== -->
  <section id="manifesto" class="section manifesto">
    <div class="container">
      <div class="manifesto__inner">
        <div class="section__head reveal">
          <span class="eyebrow">Manifesto</span>
          <h2 class="text-balance">You&rsquo;re in the business of showing up for people.</h2>
          <span class="bar"></span>
        </div>
        <div class="prose prose--justify reveal reveal--delay-1">
          <p>That takes everything you&rsquo;ve got. We know that.</p>
          <p>We&rsquo;re here so your story gets the same care you give to everyone else&rsquo;s &mdash; through photo, film, brand strategy, and websites that actually do their job.</p>
          <p>Because the work you do deserves to be seen.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== SERVICES / BENTO ========== -->
  <section class="section services-bento-section">
    <div class="container">
      <div class="section__head reveal">
        <span class="eyebrow">Services</span>
        <h2 class="text-balance">What we make, together.</h2>
        <span class="bar"></span>
        <p class="section__lede">We work across four things, and they tend to talk to each other.</p>
      </div>

      <div class="bento">
        {bento.map((b, i) => (
          <a
            href={b.href}
            class:list={[
              'bento__card',
              `bento__card--${b.color}`,
              `bento__card--${b.size}`,
              'reveal',
              `reveal--delay-${(i % 4) + 1}`,
            ]}
            style={b.image ? `background-image: url('${encodeURI(b.image)}')` : ''}
          >
            <div class="bento__body">
              <h3 class="bento__title">{b.title}</h3>
              <p class="bento__blurb">{b.blurb}</p>
            </div>
            <span class="bento__cta" aria-hidden="true">
              Explore <span class="arrow">&rarr;</span>
            </span>
          </a>
        ))}
      </div>

      <p class="services-foot reveal reveal--delay-2">Hire us for one. Hire us for all four. We&rsquo;ll meet you where you are.</p>

      <div class="reveal reveal--delay-3" style="margin-top: 1.5rem;">
        <a href="/services" class="link">See the services <span class="arrow">&rarr;</span></a>
      </div>
    </div>
  </section>

  <!-- ========== WORK TEASER ========== -->
  <section class="section section--warm work">
    <div class="container">
      <div class="section__head section__head--row reveal">
        <div>
          <span class="eyebrow">Work</span>
          <h2>Recent work.</h2>
          <span class="bar"></span>
        </div>
        <a href="/work" class="link work__see-all">
          See all work <span class="arrow">&rarr;</span>
        </a>
      </div>

      <div class="work__grid">
        {featured.map((p, i) => (
          <div class:list={['reveal', `reveal--delay-${i + 1}`]}>
            <ProjectCard
              href={p.href}
              title={p.title}
              category={p.category}
              image={p.image}
              ratio={p.ratio}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========== WHY US ========== -->
  <section class="section section--sage film-grain why-us">
    <div class="container">
      <div class="why-us__copy reveal">
        <span class="eyebrow">Why us</span>
        <h2 class="text-balance">We show up like a good neighbour.</h2>
        <span class="bar"></span>
        <div class="prose">
          <p>We listen before we pitch. We ask about the people you serve before we talk about deliverables. And we stay honest &mdash; about what things cost, what will work, and whether we&rsquo;re the right fit.</p>
          <p>You focus on your people. We&rsquo;ll handle the rest.</p>
        </div>
        <a href="/about" class="link" style="margin-top: 1rem; display: inline-flex; align-items: center; gap: 0.35rem;">Meet us <span class="arrow">&rarr;</span></a>
      </div>
    </div>

    <div class="camera-reel reveal reveal--delay-2" aria-hidden="true">
      <div class="camera-reel__frame">
        <img src="/images/bts/camera-reel-1.jpg" alt="" loading="lazy" class="camera-reel__img" />
      </div>
      <div class="camera-reel__frame">
        <img src="/images/bts/camera-reel-2.jpg" alt="" loading="lazy" class="camera-reel__img" />
      </div>
      <div class="camera-reel__frame">
        <img src="/images/bts/camera-reel-3.jpg" alt="" loading="lazy" class="camera-reel__img" />
      </div>
      <div class="camera-reel__frame">
        <img src="/images/bts/camera-reel-4.jpg" alt="" loading="lazy" class="camera-reel__img" />
      </div>
    </div>
  </section>

  <!-- ========== FINAL CTA ========== -->
  <section class="section--lavender cta-band film-grain">
    <div class="container cta-band__inner reveal">
      <h2 class="text-balance">Tell us about your work.</h2>
      <p>Not a pitch &mdash; just a conversation. We read every message ourselves.</p>
      <div class="btn-group">
        <a href="/contact" class="btn btn--solid">Start the conversation &rarr;</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ---- Hero ---- */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    min-height: 100svh;
    padding: 2rem 0;
    overflow: hidden;
    background:
      radial-gradient(ellipse at 50% 0%, rgba(234, 170, 66, 0.24) 0%, transparent 55%),
      radial-gradient(circle at 15% 100%, rgba(85, 156, 173, 0.10) 0%, transparent 45%),
      var(--paper);
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
    max-width: 1100px;
  }

  .hero__logo {
    margin: 0;
    line-height: 0;
  }

  .hero__logo img {
    width: clamp(300px, 60vw, 760px);
    height: auto;
    display: block;
  }

  /* ---- Hero scroll indicator ---- */
  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: clamp(1.5rem, 4vh, 2.5rem);
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    color: var(--ink-soft, var(--ink));
    text-decoration: none;
    opacity: 0.75;
    transition: opacity var(--t-base) var(--ease);
  }

  .hero__scroll:hover { opacity: 1; }

  .hero__scroll-label {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .hero__scroll-mouse {
    width: 22px;
    height: 36px;
    border: 1.5px solid currentColor;
    border-radius: 12px;
    display: flex;
    justify-content: center;
    padding-top: 6px;
  }

  .hero__scroll-wheel {
    width: 2px;
    height: 6px;
    background: currentColor;
    border-radius: 2px;
    animation: hero-scroll-wheel 1.8s ease-in-out infinite;
  }

  @keyframes hero-scroll-wheel {
    0%   { transform: translateY(0);    opacity: 1; }
    60%  { transform: translateY(10px); opacity: 0; }
    61%  { transform: translateY(0);    opacity: 0; }
    100% { transform: translateY(0);    opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scroll-wheel { animation: none; }
  }

  .hero__headline {
    font-family: var(--font-display);
    font-weight: 500;
    color: var(--lavender-deep);
    font-size: clamp(1rem, 1.6vw, 1.375rem);
    line-height: 1.4;
    letter-spacing: -0.01em;
    max-width: 32ch;
    margin: 0;
  }

  .hero__sub {
    font-family: var(--font-sans);
    font-size: clamp(0.9375rem, 1.3vw, 1.0625rem);
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 0;
    letter-spacing: 0.01em;
  }

  .hero__lede {
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 54ch;
    margin: 0;
  }

  .hero .btn-group { justify-content: center; margin-top: 0.75rem; }

  @media (max-width: 768px) {
    .hero__logo img { width: min(78vw, 480px); }
    .hero { padding: 5rem 0 4rem; }
    .hero__scroll { bottom: 1.25rem; }
    .hero__scroll-label { font-size: 0.625rem; }
  }

  /* ---- Manifesto ---- */
  .manifesto {
    position: relative;
    background: url('/images/family-photo.jpg') center 35% / cover no-repeat;
  }

  .manifesto::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(250, 249, 246, 0.86);
    z-index: 0;
  }

  .manifesto .container {
    position: relative;
    z-index: 1;
  }

  .manifesto__inner {
    max-width: 880px;
    margin: 0;
    text-align: left;
  }

  .manifesto .section__head { max-width: none; }

  .prose--justify p {
    text-align: justify;
    hyphens: auto;
  }

  /* ---- Section heads ---- */
  .section__head {
    margin-bottom: 3rem;
    max-width: 720px;
  }

  .section__head .eyebrow { margin-bottom: 1rem; }
  .section__head h2 { margin-bottom: 1.25rem; }
  .section__lede {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--ink-soft);
    max-width: 58ch;
    margin-top: 1.25rem;
  }

  .section__head--row {
    max-width: none;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  /* ---- Services bento ---- */
  .services-bento-section { border-top: 1px solid var(--rule); }

  .bento {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-auto-rows: minmax(220px, auto);
    gap: 1rem;
  }

  .bento__card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.75rem;
    border-radius: var(--radius-lg);
    color: var(--paper);
    overflow: hidden;
    isolation: isolate;
    transition: transform var(--t-base) var(--ease), box-shadow var(--t-base) var(--ease);
    border: 1px solid var(--rule);
    min-height: 220px;
    background-size: cover;
    background-position: center;
  }

  .bento__card::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    transition: opacity var(--t-base) var(--ease);
  }

  .bento__card > * { position: relative; z-index: 1; }

  .bento__card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lift);
  }

  .bento__card--lg {
    grid-column: span 3;
    grid-row: span 2;
    min-height: 460px;
  }

  .bento__card--md { grid-column: span 3; }

  .bento__card--wide { grid-column: 1 / -1; }

  .bento__card--honey::before {
    background: linear-gradient(to top, rgba(192, 140, 57, 0.88) 0%, rgba(234, 170, 66, 0.55) 50%, rgba(0,0,0,0.2) 100%);
  }

  .bento__card--teal::before {
    background: linear-gradient(to top, rgba(42, 100, 115, 0.92) 0%, rgba(85, 156, 173, 0.6) 50%, rgba(0,0,0,0.25) 100%);
  }

  .bento__card--lavender::before {
    background: linear-gradient(to top, rgba(59, 53, 72, 0.95) 0%, rgba(106, 98, 120, 0.65) 50%, rgba(0,0,0,0.3) 100%);
  }

  .bento__card--sage::before {
    background: linear-gradient(to top, rgba(60, 100, 70, 0.88) 0%, rgba(85, 136, 100, 0.55) 50%, rgba(0,0,0,0.2) 100%);
  }

  .bento__body { margin-top: auto; }

  .bento__title {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--paper);
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .bento__card--lg .bento__title { font-size: clamp(1.75rem, 3vw, 2.25rem); }

  .bento__blurb {
    color: rgba(250, 249, 246, 0.88);
    font-size: 0.9375rem;
    line-height: 1.6;
    max-width: 36ch;
  }

  .bento__card--lg .bento__blurb { font-size: 1rem; max-width: 42ch; }

  .bento__cta {
    margin-top: 1.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(250, 249, 246, 0.9);
  }

  .bento__cta .arrow { transition: transform var(--t-base) var(--ease); display: inline-block; }
  .bento__card:hover .bento__cta .arrow { transform: translateX(4px); }

  .services-foot {
    margin-top: 2.5rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--ink-soft);
    max-width: 60ch;
  }

  @media (max-width: 960px) {
    .bento { grid-template-columns: repeat(2, 1fr); grid-auto-rows: auto; }
    .bento__card--lg, .bento__card--md, .bento__card--wide {
      grid-column: span 1;
      grid-row: auto;
      min-height: 240px;
    }
  }

  @media (max-width: 560px) {
    .bento { grid-template-columns: 1fr; }
    .bento__card--lg, .bento__card--md, .bento__card--wide { grid-column: span 1; }
  }

  /* ---- Work grid ---- */
  .work__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 300px));
    justify-content: center;
    gap: 1.5rem;
    max-width: 960px;
    margin: 0 auto;
  }

  .work__grid :global(.project-card__title) { font-size: 0.9375rem; }
  .work__grid :global(.project-card__category) { font-size: 0.6875rem; }
  .work__grid :global(.project-card__caption) { margin-top: 0.75rem; }

  .work__see-all { white-space: nowrap; }

  @media (max-width: 820px) {
    .work__grid { gap: 1rem; }
  }

  /* ---- Why us ---- */
  .why-us {
    padding-bottom: 0;
  }

  .why-us__copy {
    max-width: 680px;
  }

  .why-us__copy .bar { margin-bottom: 1.5rem; }

  /* ---- Camera reel ---- */
  .camera-reel {
    display: flex;
    width: 100%;
    margin-top: 3rem;
    overflow: hidden;
  }

  .camera-reel__frame {
    flex: 1;
    min-width: 0;
    line-height: 0;
    overflow: hidden;
  }

  .camera-reel__frame:not(:last-child) {
    border-right: 2px solid var(--sage-soft, #BCD8C1);
  }

  .camera-reel__img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
    filter: contrast(1.02) saturate(0.9);
    transition: transform 0.5s ease, filter 0.5s ease;
  }

  .camera-reel__frame:hover .camera-reel__img {
    transform: scale(1.03);
    filter: contrast(1.05) saturate(1);
  }

  @media (max-width: 640px) {
    .camera-reel {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x mandatory;
    }
    .camera-reel__frame {
      flex: 0 0 80vw;
      scroll-snap-align: start;
    }
  }

  /* ---- CTA band ---- */
  .cta-band {
    padding: clamp(5rem, 10vw, 8rem) 0;
    text-align: center;
    background:
      radial-gradient(circle at 80% 20%, rgba(234, 170, 66, 0.15), transparent 50%),
      var(--lavender-deep);
  }

  .cta-band__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    max-width: 640px;
  }

  .cta-band h2 {
    color: var(--paper);
    font-size: clamp(1.875rem, 3.6vw, 2.75rem);
    margin: 0.5rem 0 0.5rem;
  }

  .cta-band p {
    color: rgba(250, 249, 246, 0.82);
    font-size: 1.0625rem;
    margin-bottom: 1rem;
  }
</style>
