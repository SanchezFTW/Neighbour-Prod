---
const currentPath = Astro.url.pathname;

const navLinks = [
  { label: 'Work',     href: '/#work',     isCta: false },
  { label: 'Services', href: '/#services', isCta: false },
  { label: 'About',    href: '/#about',    isCta: false },
  { label: 'Contact',  href: '/#contact',  isCta: true  },
];

const isHome = currentPath === '/';
---

<header id="site-header" class="header">
  <div class="container header__inner">
    <a href="/" class="header__logo" aria-label="Neighbour — home">
      <img
        class="header__logo-img header__logo-img--wordmark"
        src="/images/logos/Neighbour Logo Color.png"
        alt="Neighbour"
      />
      <img
        class="header__logo-img header__logo-img--mark"
        src="/images/logos/Neighbour Circle Logo.svg"
        alt="Neighbour"
      />
    </a>

    <nav id="primary-nav" class="header__nav" aria-label="Main navigation">
      <ul class="header__nav-list">
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              class:list={[
                'header__nav-link',
                { 'header__nav-link--cta': link.isCta },
              ]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <button
      type="button"
      class="header__burger"
      id="nav-toggle"
      aria-controls="primary-nav"
      aria-expanded="false"
      aria-label="Open menu"
    >
      <span class="header__burger-box" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </button>
  </div>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 1.1rem 0;
    background-color: rgba(250, 249, 246, 0.86);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--t-base) ease, padding var(--t-base) ease, background-color var(--t-base) ease;
  }

  .header.is-scrolled {
    border-bottom-color: var(--rule);
    padding: 0.7rem 0;
  }

  /* When the mobile menu is open, the header is fully opaque and always visible */
  .header.is-nav-open {
    background-color: var(--paper);
    border-bottom-color: var(--rule);
    opacity: 1;
    visibility: visible;
    transform: none;
    pointer-events: auto;
  }

  .header__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .header__logo {
    position: relative;
    z-index: 120;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    line-height: 0;
    color: var(--lavender-deep);
  }

  .header__logo-img {
    height: 30px;
    width: auto;
    transition: opacity var(--t-base) var(--ease);
  }

  .header__logo-img--mark { display: none; }

  .header__logo:hover .header__logo-img { opacity: 0.75; }

  .header.is-scrolled .header__logo-img { height: 26px; }

  .header__nav-list {
    display: flex;
    align-items: center;
    gap: 2.25rem;
  }

  .header__nav-link {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--ink-soft);
    position: relative;
    padding: 0.25rem 0;
    letter-spacing: 0.01em;
  }

  .header__nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--honey);
    border-radius: 2px;
    transition: width var(--t-base) var(--ease);
  }

  .header__nav-link:hover { color: var(--honey-deep); }

  .header__nav-link:hover::after,
  .header__nav-link.is-active::after {
    width: 100%;
  }

  .header__nav-link.is-active { color: var(--lavender-deep); }

  .header__nav-link--cta {
    background: var(--honey);
    color: var(--ink) !important;
    padding: 0.45rem 1.1rem;
    border-radius: 999px;
    font-weight: 600;
    transition: background var(--t-fast) ease, transform var(--t-fast) ease;
  }

  .header__nav-link--cta::after { display: none; }

  .header__nav-link--cta:hover {
    background: var(--honey-deep);
    color: var(--ink) !important;
    transform: translateY(-1px);
  }

  .header__burger {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    margin: 0;
    z-index: 120;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  .header__burger-box {
    position: relative;
    display: block;
    width: 22px;
    height: 14px;
  }

  .header__burger-box span {
    position: absolute;
    left: 0;
    right: 0;
    height: 1.75px;
    background-color: var(--ink);
    border-radius: 2px;
    transition: transform var(--t-base) var(--ease), opacity var(--t-fast) ease, top var(--t-base) var(--ease);
  }

  .header__burger-box span:nth-child(1) { top: 0; }
  .header__burger-box span:nth-child(2) { top: 6px; }
  .header__burger-box span:nth-child(3) { top: 12px; }

  .header__burger[aria-expanded="true"] .header__burger-box span:nth-child(1) {
    top: 6px;
    transform: rotate(45deg);
  }
  .header__burger[aria-expanded="true"] .header__burger-box span:nth-child(2) {
    opacity: 0;
  }
  .header__burger[aria-expanded="true"] .header__burger-box span:nth-child(3) {
    top: 6px;
    transform: rotate(-45deg);
  }

  @media (max-width: 820px) {
    .header__logo-img--wordmark { display: none; }
    .header__logo-img--mark {
      display: block;
      height: 36px;
    }
    .header.is-scrolled .header__logo-img--mark { height: 32px; }

    .header__burger { display: inline-flex; }

    .header__nav {
      position: fixed;
      inset: 0;
      background-color: var(--paper);
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
      transition: opacity 0.35s var(--ease), visibility 0.35s, transform 0.35s var(--ease);
      z-index: 110;
      padding: 6rem var(--pad) 3rem;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
    }

    .header__nav.is-open {
      opacity: 1;
      visibility: visible;
      transform: none;
    }

    .header__nav-list {
      flex-direction: column;
      gap: 1.75rem;
      text-align: center;
      width: 100%;
    }

    .header__nav-list li {
      opacity: 0;
      transform: translateY(10px);
      transition: opacity 0.45s var(--ease), transform 0.45s var(--ease);
    }

    .header__nav.is-open .header__nav-list li {
      opacity: 1;
      transform: none;
    }

    .header__nav.is-open .header__nav-list li:nth-child(1) { transition-delay: 0.10s; }
    .header__nav.is-open .header__nav-list li:nth-child(2) { transition-delay: 0.16s; }
    .header__nav.is-open .header__nav-list li:nth-child(3) { transition-delay: 0.22s; }
    .header__nav.is-open .header__nav-list li:nth-child(4) { transition-delay: 0.28s; }
    .header__nav.is-open .header__nav-list li:nth-child(5) { transition-delay: 0.34s; }

    .header__nav-link {
      font-family: var(--font-display);
      font-size: clamp(1.75rem, 7vw, 2.25rem);
      font-weight: 600;
      color: var(--lavender-deep);
      letter-spacing: -0.01em;
      padding: 0.5rem 0;
      display: inline-block;
    }

    .header__nav-link::after {
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      height: 3px;
    }

    .header__nav-link.is-active::after {
      width: 40%;
    }

    .header__nav-link--cta {
      padding: 0.6rem 2rem;
    }
  }
</style>

<script>
  function initHeader() {
    const header = document.getElementById('site-header');
    const toggle = document.getElementById('nav-toggle');
    const nav = document.getElementById('primary-nav');
    if (!header || !toggle || !nav) return;

    // Guard against duplicate binding across Astro view transitions.
    if ((toggle as any).__neighbourBound) return;
    (toggle as any).__neighbourBound = true;

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      nav.classList.toggle('is-open', open);
      header.classList.toggle('is-nav-open', open);
      document.body.style.overflow = open ? 'hidden' : '';
    };

    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

    toggle.addEventListener('click', (e) => {
      e.preventDefault();
      setOpen(!isOpen());
    });

    nav.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement).closest('a');
      if (link) setOpen(false);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) {
        setOpen(false);
        toggle.focus();
      }
    });

    // Close menu if the viewport expands past the mobile breakpoint.
    const mq = window.matchMedia('(min-width: 821px)');
    const onMq = () => { if (mq.matches && isOpen()) setOpen(false); };
    if (mq.addEventListener) mq.addEventListener('change', onMq);
    else mq.addListener(onMq);
  }

  function initScroll() {
    const header = document.getElementById('site-header');
    if (!header) return;
    const handleScroll = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 24);
    };
    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();
  }

  function boot() {
    initHeader();
    initScroll();
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
