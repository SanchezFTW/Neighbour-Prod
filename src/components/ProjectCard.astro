---
interface Props {
  href: string;
  title: string;
  category: string;
  image?: string;
  ratio?: string;
  size?: 'default' | 'tall' | 'wide';
}

const {
  href,
  title,
  category,
  image,
  ratio = '4/5',
  size = 'default'
} = Astro.props;
---

<a href={href} class:list={['project-card', `project-card--${size}`]} aria-label={`${title} — ${category}`}>
  <div class="project-card__frame card-img" style={`aspect-ratio: ${ratio};`}>
    {image && (
      <img
        src={image}
        alt={title}
        loading="lazy"
        decoding="async"
        onerror="this.style.display='none';var ph=this.parentElement.querySelector('.project-card__placeholder');if(ph)ph.style.display='flex'"
      />
    )}
    <div class="project-card__placeholder" style={image ? 'display:none' : undefined} aria-hidden="true">
      <span>{category}</span>
    </div>
    <div class="card-img__overlay">
      <div>
        <p class="card-img__meta">{category}</p>
        <p class="card-img__title">{title}</p>
      </div>
    </div>
  </div>
  <div class="project-card__caption">
    <p class="project-card__title">{title}</p>
    <p class="project-card__category">{category}</p>
  </div>
</a>

<style>
  .project-card {
    display: block;
    color: inherit;
  }

  .project-card__frame {
    width: 100%;
  }

  .project-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--paper-warm), var(--sage-soft));
    color: var(--lavender);
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .project-card__caption {
    margin-top: 1rem;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .project-card__title {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--lavender-deep);
    font-size: 1rem;
    letter-spacing: -0.01em;
  }

  .project-card__category {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }

  .project-card:hover .project-card__title {
    color: var(--honey-deep);
  }
</style>
