<footer class="footer">
  <div class="footer__divider" aria-hidden="true"></div>

  <div class="container footer__inner">
    <a href="/" class="footer__wordmark" aria-label="Neighbour Productions — home">
      <img
        src="/images/logos/Neighbour Productions Color.png"
        alt="Neighbour Productions"
      />
    </a>

    <nav class="footer__nav" aria-label="Footer">
      <a href="/" class="footer__link">Home</a>
      <a href="/about" class="footer__link">About</a>
      <a href="/work" class="footer__link">Work</a>
      <a href="/services" class="footer__link">Services</a>
      <a href="/contact" class="footer__link">Contact</a>
    </nav>

    <p class="footer__meta">
      <a href="mailto:info@neighbourprod.com" class="footer__link">info@neighbourprod.com</a>
      <span class="footer__sep" aria-hidden="true">·</span>
      <a href="https://www.instagram.com/neighbour_productions/" class="footer__link" target="_blank" rel="noopener">Instagram</a>
    </p>
  </div>
</footer>

<button class="back-to-top" id="back-to-top" aria-label="Back to top">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <line x1="12" y1="19" x2="12" y2="5"></line>
    <polyline points="5 12 12 5 19 12"></polyline>
  </svg>
</button>

<style>
  .footer {
    margin-top: auto;
    padding: 3rem 0 2.5rem;
    background: var(--paper-cream);
    color: var(--ink-soft);
    font-size: 0.9375rem;
    position: relative;
    overflow: hidden;
  }

  .footer__divider {
    height: 3px;
    background: linear-gradient(90deg, var(--honey), var(--honey-deep) 40%, var(--teal) 70%, var(--sage) 100%);
    margin-bottom: 2.5rem;
    width: 100%;
  }

  .footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 2rem;
    flex-wrap: wrap;
  }

  .footer__nav {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    font-size: 0.875rem;
    letter-spacing: 0.02em;
  }

  .footer__wordmark {
    display: inline-flex;
    align-items: center;
    line-height: 0;
    transition: opacity var(--t-base) var(--ease);
  }

  .footer__wordmark img {
    height: 42px;
    width: auto;
  }

  .footer__wordmark:hover { opacity: 0.78; }

  .footer__meta {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    color: var(--ink-soft);
  }

  .footer__link {
    color: var(--ink-soft);
    border-bottom: 1px solid var(--rule-strong);
    padding-bottom: 1px;
    transition: color var(--t-fast) ease, border-color var(--t-fast) ease;
  }

  .footer__link:hover {
    color: var(--honey-deep);
    border-bottom-color: var(--honey-deep);
  }

  .footer__sep {
    color: var(--ink-mute);
    opacity: 0.7;
  }

  @media (max-width: 560px) {
    .footer {
      padding: 2.5rem 0 2rem;
      text-align: center;
    }
    .footer__divider { margin-bottom: 2rem; }
    .footer__inner {
      flex-direction: column;
      align-items: center;
      gap: 1.5rem;
    }
    .footer__nav {
      justify-content: center;
      gap: 1rem 1.25rem;
    }
    .footer__meta {
      justify-content: center;
    }
    .footer__wordmark img { height: 36px; }
  }
</style>

<script>
  function setupBackToTop() {
    const btn = document.getElementById('back-to-top');
    if (!btn) return;

    const onScroll = () => {
      btn.classList.toggle('is-visible', window.scrollY > 600);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }

  setupBackToTop();
  document.addEventListener('astro:page-load', setupBackToTop);
</script>
